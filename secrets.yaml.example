# Copy this file to secrets.yaml (same folder as your device YAML) and
# fill in your own values. secrets.yaml is gitignored — never commit it.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Generate a fresh key with: `esphome secrets` or `openssl rand -base64 32`
api_encryption_key: "PASTE_A_BASE64_32_BYTE_KEY_HERE"

# Any strong password — required for OTA (over-the-air) firmware updates.
ota_password: "choose-a-strong-ota-password"
